# Copy to .env and fill in real values. Never commit .env with real secrets.

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/order_tracking_dev"

# Auth.js signing secret. REQUIRED in every environment; at least 32
# characters. Generate with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# https://authjs.dev/getting-started/installation
# The app fails fast at startup if this is missing or too short
# (src/lib/env/auth-env.ts). Never commit a real value.
AUTH_SECRET=""

# Auth.js only auto-trusts the request host while running `next dev`.
# Serving a production build (`next start`, or a managed host) requires the
# host to be trusted explicitly, otherwise sign-in fails with
# "UntrustedHost" (HTTP 500 on /api/auth/*). Set this in the production
# environment; leave it unset locally.
# AUTH_TRUST_HOST="true"
