// Prisma schema — Milestone 1 + Milestone 2 scope.
//
// M1 added the `User` model. Per DEC-001 (accepted, amended 2026-09-05),
// authentication uses Auth.js Credentials + JWT sessions, so no `Session`,
// `Account`, or `VerificationToken` table is required or present.
//
// M2 adds Business, BusinessMember, and BusinessInvitation per the approved
// M2 database design (business onboarding / settings / membership).
//
// Milestone additions so far: M3 `Customer`; M4 `Product` (per the owner's
// DEC-006 acceptance, `price` is DECIMAL(12,2)). Do not add Order or any
// other later-milestone domain model here — those belong to later
// milestones per MASTER_SPEC.md §44 and docs/roadmap.md, and must not be
// pre-built in M4.
//
// Prisma 7 compatibility note: as of Prisma 7, `datasource.url` is no
// longer supported directly in schema.prisma (P1012). Connection
// configuration now lives in two places instead:
//   - `prisma.config.ts` (project root) — used by the Prisma CLI
//     (generate/validate/migrate).
//   - The driver adapter passed to the `PrismaClient` constructor at
//     runtime (`src/lib/db/client.ts`), via `@prisma/adapter-pg`.
// This is an implementation-detail compatibility fix only — it does not
// change the approved architecture (PostgreSQL, Prisma, DEC-001, DEC-008,
// DEC-009 are all unaffected).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Application-level identity record.
///
/// MASTER_SPEC.md §8: "Authentication identity should primarily be managed
/// by the selected auth provider... Do NOT store passwords unless the
/// selected authentication architecture explicitly requires it." The
/// accepted DEC-001 Credentials-provider architecture explicitly requires
/// storing a password hash (there is no external identity provider to hold
/// it), so `passwordHash` is included deliberately, not by default.
///
/// `sessionVersion` implements the DEC-001 amendment's global JWT
/// invalidation mechanism: incrementing it invalidates every previously
/// issued JWT for this user on their next authorization check. It is not
/// per-session revocation — see docs/architecture-decisions.md DEC-001.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// M2: a user's memberships in customer-business tenants. This is the
  /// application-owned business-role relation (`OWNER` | `STAFF`) and is
  /// intentionally separate from any future platform/company authorization
  /// domain (`SUPER_ADMIN` | `ADMIN`, DEC-009) — see BusinessMember below.
  memberships BusinessMember[]

  @@map("users")
}

/// M2: business-role domain. Closed to exactly OWNER | STAFF per DEC-008 /
/// docs/database.md §3A. Never add ADMIN, SUPER_ADMIN, or any other value
/// here — platform/company roles belong to a separate, not-yet-implemented
/// authorization domain and must never be stored in BusinessMember.role.
enum BusinessMemberRole {
  OWNER
  STAFF
}

/// M2: a tenant (customer business). Approved core-fields shape per
/// docs/database.md §2 "Business" and the M2 implementation spec.
model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  description String?
  currency    String
  timezone    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     BusinessMember[]
  invitations BusinessInvitation[]
  customers   Customer[]
  products    Product[]

  @@map("businesses")
}

/// M3: a tenant-owned customer record (MASTER_SPEC.md §19 / docs/database.md
/// §2 "Customer"). `businessId` is the tenant key (DB-001) and every read or
/// write is scoped by it through the membership-authorized service layer.
///
/// Deletion is SOFT (`deletedAt`): docs/database.md DB-003 and MASTER_SPEC.md
/// §7 require historical order relationships to survive, so a customer that
/// has ever been ordered for must never be physically removed. All normal
/// reads filter `deletedAt IS NULL`.
///
/// No uniqueness constraint is defined here: the approved field list has no
/// unique attribute (unlike Business.slug or BusinessMember's composite key),
/// so two customers may legitimately share a name or phone number.
model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id])

  /// List ordering (newest first per tenant) and the two documented customer
  /// access paths in docs/database.md §4 (`Customer.businessId`,
  /// `Customer.phone`). Note that the name/phone search uses a contains match,
  /// which cannot use a b-tree index; these indexes carry the tenant-scoped
  /// list and exact-value lookups. No index is added for `name` because the
  /// source does not identify it as a high-value access path.
  @@index([businessId, createdAt])
  @@index([businessId, phone])
  @@map("customers")
}

/// M4: a tenant-owned product the business sells (MASTER_SPEC.md §8
/// "Product", Milestone 4 "Products: CRUD, Active/inactive"). `businessId`
/// is the tenant key (DB-001) and every read or write is scoped by it
/// through the membership-authorized service layer.
///
/// `price` is DECIMAL(12,2) per the owner's accepted DEC-006 ("Prisma
/// Decimal"): a PostgreSQL decimal representation, not binary floating
/// point. BUSINESS.currency carries the display currency symbol; DECIMAL
/// stores only the numeric amount, so switching currencies later does not
/// require restoring existing values.
///
/// `active` implements MASTER_SPEC.md "Active/inactive": inactive products
/// are never added to NEW orders (an M5 order-creation filter), and an
/// existing product being deactivated does NOT mutate historical orders
/// (M5 order items snapshot productName/unitPrice per MASTER_SPEC.md
/// §10, enforced at order time).
///
/// `deletedAt` is soft-delete (DB-003) for the same reason as Customer:
/// an order item names a product that must remain resolvable, and it must
/// not appear as a sellable item. A deleted product is filtered out of
/// every list/read.
model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id])

  /// (businessId) supports the tenant-scoped product list. (businessId,
  /// active) additionally serves the M5 order-creation picker (which reads
  /// only ACTIVE products). No index on `name`: product count per tenant is
  /// small for this MVP and no source requirement asks a name index.
  @@index([businessId, createdAt])
  @@index([businessId, active])
  @@map("products")
}

/// M2: membership of a User in a Business, carrying the closed business
/// role. Uniqueness on (businessId, userId) prevents duplicate membership.
model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

/// M2: invite-by-link membership invitation. Only a SHA-256 hash of the
/// raw invitation token is ever persisted (see the invitation service) —
/// the raw token exists only transiently in the create-invitation response.
///
/// IMPORTANT: at most one *database-active* invitation
/// (`revokedAt IS NULL AND acceptedAt IS NULL`) may exist per
/// (businessId, normalized email). Prisma's schema DSL cannot express a
/// partial unique index, so this invariant is additionally enforced by a
/// hand-added PostgreSQL partial unique index in the migration SQL
/// (`business_invitations_active_email_key`). Do not remove or "simplify"
/// that index in a future migration — it is the authoritative concurrency
/// guard, not merely a performance index. See migration
/// 20260907_add_business_membership for the exact DDL and rationale.
model BusinessInvitation {
  id         String             @id @default(cuid())
  businessId String
  email      String
  role       BusinessMemberRole
  tokenHash  String             @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, email])
  @@index([email])
  @@map("business_invitations")
}
